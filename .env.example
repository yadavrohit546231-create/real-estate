# ==============================================
# Real Estate Marketplace Environment Variables
# ==============================================

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (Component-based)
DATABASE_USER="root"
DATABASE_PASSWORD="your_database_password"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_NAME="real-estate"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="super-secure-access-secret-key-change-in-production-32chars"
JWT_REFRESH_SECRET="super-secure-refresh-secret-key-change-in-production-32chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:19006,http://localhost:8081"

# Storage Provider: 'local' or 'cloudinary'
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"

# Cloudinary (Optional - Required only if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay (Optional - if blank, development mock mode is enabled)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
MOCK_PAYMENTS_ENABLED="true"

# Expo Push Notifications
EXPO_PUSH_ACCESS_TOKEN=""

# Google Maps API Key
GOOGLE_MAPS_API_KEY=""

# Admin Web App
VITE_API_URL="http://localhost:5000/api"

# Mobile Expo App
EXPO_PUBLIC_API_URL="http://localhost:5000/api"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BUYER
  OWNER
  AGENT
  BUILDER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ListingType {
  SALE
  RENT
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  PG
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  LIVE
  PAUSED
  SOLD
  RENTED
  EXPIRED
  DELETED
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum AreaUnit {
  SQ_FT
  SQ_YARD
  SQ_METER
  ACRE
  HECTARE
  BIGHA
}

enum LeadSource {
  CALL
  WHATSAPP
  ENQUIRY
  WEBSITE
  MOBILE_APP
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  SITE_VISIT
  NEGOTIATION
  CONVERTED
  LOST
  CLOSED
}

enum SiteVisitStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  SOLD
  HOLD
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  LIVE
  REJECTED
}

enum PaymentPurpose {
  FEATURED_PROPERTY
  SUBSCRIPTION
  PREMIUM_LISTING
  BUILDER_SUBSCRIPTION
  AGENT_SUBSCRIPTION
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  PROPERTY_UPDATED
  NEW_LEAD
  LEAD_STATUS_CHANGED
  SITE_VISIT_REQUEST
  SITE_VISIT_ACCEPTED
  SITE_VISIT_REJECTED
  SITE_VISIT_REMINDER
  NEW_MATCHING_PROPERTY
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ACCOUNT_VERIFIED
  GENERAL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String
  passwordHash String
  role         UserRole   @default(BUYER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  propertiesOwned     Property[]           @relation("OwnerProperties")
  propertiesAgented   Property[]           @relation("AgentProperties")
  leadsCreated        Lead[]               @relation("BuyerLeads")
  leadsReceived       Lead[]               @relation("OwnerLeads")
  leadsAssigned       Lead[]               @relation("AgentLeads")
  siteVisitsRequested SiteVisit[]          @relation("UserSiteVisits")
  siteVisitsReceived  SiteVisit[]          @relation("OwnerSiteVisits")
  siteVisitsManaged   SiteVisit[]          @relation("AgentSiteVisits")
  favorites           Favorite[]
  savedSearches       SavedSearch[]
  notifications       Notification[]
  notificationTokens  NotificationToken[]
  payments            Payment[]
  subscriptions       Subscription[]
  adminApprovals      PropertyApproval[]   @relation("AdminApprovals")
  adminActions        AdminAction[]        @relation("AdminActions")
  agentProfile        AgentProfile?
  builderProfile      BuilderProfile?
  builderProjects     BuilderProject[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AgentProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName      String
  agencyAddress   String             @db.Text
  licenseNumber   String
  experienceYears Int                @default(0)
  bio             String?            @db.Text
  status          VerificationStatus @default(PENDING)
  rejectionReason String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model BuilderProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  companyAddress  String             @db.Text
  reraNumber      String
  website         String?
  description     String             @db.Text
  logoUrl         String?            @db.Text
  status          VerificationStatus @default(PENDING)
  rejectionReason String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model Location {
  id        String   @id @default(uuid())
  country   String   @default("India")
  state     String
  city      String
  locality  String
  pincode   String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([locality])
}

model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  category  String?
  createdAt DateTime @default(now())

  properties PropertyAmenity[]
  projects   ProjectAmenity[]
}

model Property {
  id              String           @id @default(uuid())
  ownerId         String
  owner           User             @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           User?            @relation("AgentProperties", fields: [agentId], references: [id], onDelete: SetNull)
  builderId       String?
  title           String
  description     String           @db.Text
  listingType     ListingType
  category        PropertyCategory
  propertyType    String
  price           Float
  rentAmount      Float?
  securityDeposit Float?
  area            Float
  areaUnit        AreaUnit         @default(SQ_FT)
  bedrooms        Int?
  bathrooms       Int?
  balconies       Int?
  floorNumber     Int?
  totalFloors     Int?
  furnishing      FurnishingStatus?
  address         String?          @db.Text
  locality        String
  city            String
  state           String
  country         String           @default("India")
  pincode         String
  latitude        Float?
  longitude       Float?
  status          PropertyStatus   @default(PENDING_REVIEW)
  isVerified      Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  featuredFrom    DateTime?
  featuredUntil   DateTime?
  rejectionReason String?          @db.Text
  availableFrom   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images      PropertyImage[]
  videos      PropertyVideo[]
  amenities   PropertyAmenity[]
  approvals   PropertyApproval[]
  leads       Lead[]
  siteVisits  SiteVisit[]
  favorites   Favorite[]

  @@index([city])
  @@index([locality])
  @@index([status])
  @@index([listingType])
  @@index([category])
  @@index([propertyType])
  @@index([price])
  @@index([ownerId])
  @@index([isFeatured])
  @@index([createdAt])
}

model PropertyImage {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url          String   @db.Text
  thumbnailUrl String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

model PropertyVideo {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url          String   @db.Text
  thumbnailUrl String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

model PropertyApproval {
  id         String           @id @default(uuid())
  propertyId String
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  adminId    String
  admin      User             @relation("AdminApprovals", fields: [adminId], references: [id])
  decision   ApprovalDecision
  reason     String?          @db.Text
  createdAt  DateTime         @default(now())

  @@index([propertyId])
  @@index([adminId])
}

model BuilderProject {
  id             String        @id @default(uuid())
  builderId      String
  builder        User          @relation(fields: [builderId], references: [id], onDelete: Cascade)
  name           String
  description    String        @db.Text
  location       String
  city           String
  state          String
  developer      String
  reraNumber     String
  totalTowers    Int           @default(1)
  totalUnits     Int           @default(1)
  possessionDate DateTime?
  priceFrom      Float
  priceTo        Float
  latitude       Float?
  longitude      Float?
  status         ProjectStatus @default(PENDING_REVIEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  towers     Tower[]
  floorPlans FloorPlan[]
  amenities  ProjectAmenity[]
  media      ProjectMedia[]

  @@index([builderId])
  @@index([city])
  @@index([status])
}

model Tower {
  id        String         @id @default(uuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  floors    Floor[]

  @@index([projectId])
}

model Floor {
  id          String   @id @default(uuid())
  towerId     String
  tower       Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  floorNumber Int
  units       Unit[]

  @@index([towerId])
}

model Unit {
  id         String     @id @default(uuid())
  floorId    String
  floor      Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber String
  bedrooms   Int
  bathrooms  Int
  area       Float
  price      Float
  status     UnitStatus @default(AVAILABLE)

  @@index([floorId])
  @@index([status])
}

model FloorPlan {
  id        String         @id @default(uuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  bedrooms  Int
  bathrooms Int
  area      Float
  imageUrl  String         @db.Text

  @@index([projectId])
}

model ProjectAmenity {
  id        String         @id @default(uuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity        @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([projectId, amenityId])
  @@index([projectId])
}

model ProjectMedia {
  id        String         @id @default(uuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String         @db.Text
  mediaType String         @default("IMAGE") // IMAGE, VIDEO, BROCHURE
  createdAt DateTime       @default(now())

  @@index([projectId])
}

model Lead {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User       @relation("BuyerLeads", fields: [buyerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User       @relation("OwnerLeads", fields: [ownerId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      User?      @relation("AgentLeads", fields: [agentId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  email      String
  message    String?    @db.Text
  source     LeadSource @default(ENQUIRY)
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([propertyId])
  @@index([buyerId])
  @@index([ownerId])
  @@index([agentId])
  @@index([status])
}

model SiteVisit {
  id         String          @id @default(uuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("UserSiteVisits", fields: [userId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User            @relation("OwnerSiteVisits", fields: [ownerId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      User?           @relation("AgentSiteVisits", fields: [agentId], references: [id], onDelete: SetNull)
  visitDate  DateTime
  timeSlot   String
  status     SiteVisitStatus @default(REQUESTED)
  notes      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([ownerId])
  @@index([agentId])
  @@index([status])
  @@index([visitDate])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model SavedSearch {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  city        String?
  criteria    String   @db.Text // JSON representation of filter criteria
  notifyEmail Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String           @db.Text
  type       NotificationType
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model NotificationToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String   @default("expo")
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Payment {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String         @default("INR")
  purpose          PaymentPurpose
  referenceId      String // e.g. propertyId
  gatewayOrderId   String         @unique
  gatewayPaymentId String?
  status           PaymentStatus  @default(CREATED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([referenceId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  action     String // "PROPERTY_APPROVED", "PROPERTY_REJECTED", etc.
  entityType String // "Property", "User", "AgentProfile", etc.
  entityId   String
  metadata   String?  @db.Text // JSON string
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}
